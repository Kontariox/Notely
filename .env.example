# Application Environment: development / production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars

# NVIDIA NIM Configuration (OpenAI-compatible)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RATE_LIMIT_RPM=40

# Transcription Engine Configuration
# Options: faster-whisper, whisper
TRANSCRIPTION_ENGINE=faster-whisper
WHISPER_MODEL=large-v3
# WHISPER_DEVICE: auto, cuda, cpu
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE: auto, float16, int8, float32, int8_float16
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=pl

# Storage & Privacy
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
DELETE_SOURCE_AFTER_PROCESSING=false

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback
GOOGLE_CALENDAR_AUTO_ADD=false

# Database Configuration (Async SQLite default, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/notely.db
